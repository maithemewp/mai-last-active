.DS_Store
.idea/
.vscode/
.phpunit.result.cache
/.phpunit.cache/

# vendor/ is committed (prod-only) so GitHub-installed zips work
# without `composer install`. Allowlist approach: everything in vendor
# is ignored except the autoloader, composer's own files, and each
# explicitly-named production package. New dev deps are auto-ignored.
# When adding a NEW prod dep, add a matching `!/vendor/<vendor>/` line.
/vendor/*
!/vendor/autoload.php
!/vendor/composer/
!/vendor/yahnis-elsts/
# Auto-regenerates with the current git ref, so tracking it dirties
# the tree after every commit.
/vendor/composer/installed.php
