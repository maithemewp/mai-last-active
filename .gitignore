/vendor/nikic/
/vendor/phar-io/
/vendor/phpunit/
/vendor/sebastian/
/vendor/theseer/
# Auto-regenerates on every `composer install` with the current git ref,
# so tracking it would dirty the tree after every commit.
/vendor/composer/installed.php
